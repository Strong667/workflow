APP_NAME="WorkFlow CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8088
FRONTEND_URL=http://localhost:5188

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_LEVEL=debug

# По ТЗ рабочая СУБД — MySQL 8. Чтобы переключиться:
#   DB_CONNECTION=mysql
# и выполнить SQL из README (создание базы и пользователя).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workflow_crm
DB_USERNAME=workflow
DB_PASSWORD=secret

SESSION_DRIVER=file
QUEUE_CONNECTION=database
CACHE_STORE=file

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
